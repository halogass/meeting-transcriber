# Copy to .env and fill in. Used by docker compose (the native app reads the same variables).

# Hugging Face token for pyannote (accept the terms on huggingface.co/pyannote/speaker-diarization-community-1)
HF_TOKEN=

# Optional: Claude summaries
ANTHROPIC_API_KEY=

# Optional: require this password (HTTP basic auth, any username) - set it whenever the app is reachable from other machines
MT_PASSWORD=

# MT_PORT=8765
# MT_WHISPER_MODEL=large-v3-turbo-q5_0
# MT_LIVE_MODEL=
